# Existing
INSTANTDB_APP_ID=
INSTANTDB_ADMIN_TOKEN=

# Google Sheets — incremental sync (recommended in production)
# Requires Sheets API enabled on the GCP project, spreadsheet shared with the service account as Viewer,
# and GOOGLE_SERVICE_ACCOUNT_FILE set. Without creds, backend falls back to public CSV export (full download each time).
GOOGLE_SERVICE_ACCOUNT_FILE=C:\Users\jonel\OneDrive\Desktop\Jonel_Projects\Keys\bayanwin-119648a96baf.json
SHEETS_INCREMENTAL_ENABLED=true
# Rows per incremental read (smaller = faster when you only append a few draws; increase if you bulk-paste many rows)
SHEETS_INCREMENTAL_WINDOW=40
SHEETS_WORKSHEET_NAME=Sheet1
# Max REST API tail chunks when gspread fails but credentials work (each chunk = SHEETS_INCREMENTAL_WINDOW rows)
SHEETS_TAIL_MAX_PASSES=25
# Reuse downloaded CSV in memory for this many seconds (same sheet); speeds repeat syncs
SHEETS_CSV_CACHE_TTL_SEC=120
# Full-CSV path: only match recent draws + last N rows against DB (set false to always scan whole sheet)
SHEETS_APPEND_ONLY_DEDUPE=true
SHEETS_APPEND_ONLY_DATE_SKEW_DAYS=5
SHEETS_DEDUPE_TAIL_ROWS=80
# Parsed rows above this use one full-table dedupe query (keep high; typical sheets use filtered key lookup)
SHEETS_DEDUPE_FULL_TABLE_THRESHOLD=20000

# Auto accuracy: post-scrape/Apify uses smaller limits so each new row does not scan 1000+ results
ACCURACY_AUTO_RESULTS_LIMIT=1000
ACCURACY_AUTO_PREDICTIONS_LIMIT=1000
ACCURACY_POST_SCRAPE_RESULTS_LIMIT=120
ACCURACY_POST_SCRAPE_PREDICTIONS_LIMIT=500

# Analysis dashboard: graph + stats load (lower = faster; cache TTL avoids repeat InstantDB hits on refresh)
GRAPH_AGG_LIMIT_DRAWS=800
GRAPH_AGG_CACHE_TTL_SEC=120
STATS_RESULTS_LIMIT=5000
STATS_API_CACHE_TTL_SEC=90

# Apify PCSO ingest (optional — runs automatically after Google Sheets scrape when actor is set)
APIFY_API_TOKEN=
APIFY_ACTOR_ID=
# Set to false to disable auto actor run after /api/scrape
APIFY_AUTO_INGEST=true
# Optional: verify POST /api/webhooks/apify
APIFY_WEBHOOK_SECRET=

# OpenAI-compatible LLM (council) — OpenAI keys start with sk- or sk-proj- (not k-proj-)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
LLM_COUNCIL_ENABLED=true
# Seventh model (Miro): two LLM rounds over graphs/stats; requires LLM_API_KEY. Set false to skip cost/latency.
MIRO_STRATEGY_ENABLED=true

# Prediction speed (/api/predict): run the six core models in parallel (wall time ≈ slowest model, not sum).
PREDICT_PARALLEL=true
# Cap thread pool (TensorFlow + XGBoost together can saturate CPU; try 4 on laptops).
PREDICT_MAX_WORKERS=6
# DRL: fewer episodes / MC samples = faster (quality tradeoff). MC 0 = use built-in default in DRL_PARAMS.
DRL_PREDICT_EPISODES=3
DRL_MC_VALIDATION_SAMPLES=0
# Decision tree Monte Carlo candidate count (env overrides mc_candidates; lower = faster).
DECISION_TREE_MC_CANDIDATES=

# Optional Zep Cloud graph enrichment for council (requires a graph id)
ZEP_API_KEY=
ZEP_GRAPH_ID=
