# Existing
INSTANTDB_APP_ID=
INSTANTDB_ADMIN_TOKEN=

# Google Sheets — incremental sync (recommended in production)
# Requires Sheets API enabled on the GCP project, spreadsheet shared with the service account as Viewer,
# and GOOGLE_SERVICE_ACCOUNT_FILE set. Without creds, backend falls back to public CSV export (full download each time).
GOOGLE_SERVICE_ACCOUNT_FILE=
SHEETS_INCREMENTAL_ENABLED=true
SHEETS_INCREMENTAL_WINDOW=250
SHEETS_WORKSHEET_NAME=Sheet1

# Apify PCSO ingest (optional — runs automatically after Google Sheets scrape when actor is set)
APIFY_API_TOKEN=
APIFY_ACTOR_ID=
# Set to false to disable auto actor run after /api/scrape
APIFY_AUTO_INGEST=true
# Optional: verify POST /api/webhooks/apify
APIFY_WEBHOOK_SECRET=

# OpenAI-compatible LLM (council) — OpenAI keys start with sk- or sk-proj- (not k-proj-)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
LLM_COUNCIL_ENABLED=true
# Seventh model (Miro): two LLM rounds over graphs/stats; requires LLM_API_KEY. Set false to skip cost/latency.
MIRO_STRATEGY_ENABLED=true

# Optional Zep Cloud graph enrichment for council (requires a graph id)
ZEP_API_KEY=
ZEP_GRAPH_ID=
